# Copy to a secure CI/CD environment configuration; do not commit real secrets.
VITE_API_BASE_URL=https://REPLACE-WITH-STAGING-API
VITE_MAPBOX_TOKEN=replace-me

# Firebase staging project
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=REPLACE-WITH-STAGING-PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REPLACE-WITH-STAGING-PROJECT
VITE_FIREBASE_STORAGE_BUCKET=REPLACE-WITH-STAGING-PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-me
VITE_FIREBASE_APP_ID=replace-me

# Legacy frontend admin key. Do not use this as a security boundary because
# VITE_* values are bundled into browser JavaScript. Remove this once admin
# actions are fully protected by authenticated backend authorization.
VITE_ADMIN_KEY=replace-me
